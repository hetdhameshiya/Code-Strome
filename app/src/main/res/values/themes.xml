<resources>
<style name="Theme.CodeStrome" parent="android:Theme.Material.NoActionBar">
    <item name="android:windowBackground">@color/cs_dark</item>
    <item name="android:statusBarColor">@color/cs_dark</item>
    <item name="android:navigationBarColor">@color/cs_dark</item>
</style>
<style name="Theme.CodeStrome.Starting" parent="Theme.SplashScreen">
<item name="windowSplashScreenBackground">@color/cs_dark</item>
<item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
<item name="postSplashScreenTheme">@style/Theme.CodeStrome</item>
</style>
</resources>